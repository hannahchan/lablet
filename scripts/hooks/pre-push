#!/usr/bin/env bash
# Git pre-push hook: the full local gate. Enabled by scripts/install-hooks.sh.
set -euo pipefail

# Whatever started git (an IDE, an agent) may have a PATH without cargo, and
# no HOME either, hence the empty defaults.
for dir in /opt/homebrew/bin "${HOME:-}/.local/bin" "${CARGO_HOME:-${HOME:-}/.cargo}/bin"; do
  if [[ -d "$dir" ]]; then
    PATH="$dir:$PATH"
  fi
done
export PATH

# Git points a hook at this repository through GIT_DIR and its relatives. The
# gate runs git in temporary repositories too, which must not inherit them.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)

# Cargo finds the `xtask` alias only from the repository root or below.
cd "$(dirname "${BASH_SOURCE[0]}")/../.."

# A push made up purely of deletions (all-zero local sha) ships no code, so it
# skips the gate. A hook run by hand, with no ref lines on stdin, still runs it.
refs=0
deletions=0
if [[ ! -t 0 ]]; then
  # The `||` guard keeps a final line that has no trailing newline.
  while read -r _ sha _ _ || [[ -n "${sha:-}" ]]; do
    refs=$((refs + 1))
    # Match the shape rather than 40 zeros so SHA-256 repositories work too.
    if [[ "$sha" =~ ^0+$ ]]; then
      deletions=$((deletions + 1))
    fi
  done
fi
if ((refs > 0 && refs == deletions)); then
  echo "pre-push: deletion-only push, skipping cargo xtask pre-push"
  exit 0
fi

# No `mise exec`: from a hook it would trust mise.toml and install missing
# pins on the spot, which is scripts/setup.sh's decision. xtask finds the tools.
exec cargo xtask pre-push
