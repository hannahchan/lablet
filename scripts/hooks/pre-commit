#!/usr/bin/env bash
# Git pre-commit hook: the fast gate. Enabled by scripts/install-hooks.sh.
set -euo pipefail

# Git runs hooks from whatever started it (an IDE, an agent), and that shell's
# PATH may lack cargo, so add the usual install locations. HOME may be unset
# there as well, hence the empty defaults.
for dir in /opt/homebrew/bin "${HOME:-}/.local/bin" "${CARGO_HOME:-${HOME:-}/.cargo}/bin"; do
  if [[ -d "$dir" ]]; then
    PATH="$dir:$PATH"
  fi
done
export PATH

# The `xtask` alias lives in the root .cargo/config.toml, which cargo only
# finds from the repository root or below.
cd "$(dirname "${BASH_SOURCE[0]}")/../.."

# xtask puts the tools pinned in mise.toml on PATH itself, finds mise where
# installers put it, and names any tool it cannot find (xtask/src/process.rs).
# No `mise exec` here: run from a hook it trusts mise.toml and installs every
# missing pin on the spot, which is scripts/setup.sh's decision to make.
exec cargo xtask pre-commit
