#!/usr/bin/env bash
# Git pre-commit hook: the fast gate. Enabled by scripts/install-hooks.sh.
set -euo pipefail

# Git runs hooks from whatever started it (an IDE, an agent), and that shell's
# PATH may lack cargo and mise, so add the usual install locations. HOME may be
# unset there as well, hence the empty defaults.
for dir in /opt/homebrew/bin "${HOME:-}/.local/bin" "${CARGO_HOME:-${HOME:-}/.cargo}/bin"; do
  if [[ -d "$dir" ]]; then
    PATH="$dir:$PATH"
  fi
done
export PATH

# The `xtask` alias lives in the root .cargo/config.toml, which cargo only
# finds from the repository root or below.
cd "$(dirname "${BASH_SOURCE[0]}")/../.."

# `mise exec` puts the versions pinned in mise.toml on PATH without needing
# shell activation. Without mise the gate still runs and names any tool it
# cannot find.
if command -v mise >/dev/null 2>&1; then
  exec mise exec -- cargo xtask pre-commit
fi
exec cargo xtask pre-commit
