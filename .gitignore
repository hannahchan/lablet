# Rust / Cargo. `**/` because lablet/ and xtask/ each have a target directory.
**/target/
**/*.pdb

# IDE / Editor
*~
*.swo
*.swp
.DS_Store
.idea/
.zed/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Environment. Provider API keys live here; the template is the one exception.
.env
.env.*
!.env.example

# Test & quality output from runs by hand; the gates write under target/.
# `coverage/` is anchored so a source directory of that name is never ignored.
*.profdata
*.profraw
lcov.info
/coverage/
/lablet/coverage/
mutants.out*/

# Run output: the OTLP/JSON file exporter writes into the working directory.
# A committed fixture in this format needs a different name.
lablet-*.otlp.jsonl

# Local configuration
*.local.toml

# Claude Code
.claude/settings.local.json
.claude/worktrees/

# Vale styles are downloaded by `vale sync`; the vocabulary is ours.
.vale/styles/*
!.vale/styles/config/
