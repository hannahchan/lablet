# Rust / Cargo. `**/` because there are two target directories: lablet/target
# and xtask/target. Cargo.lock is committed in both (binary workspace,
# reproducible gates).
**/target/
**/*.pdb

# IDE / Editor
*~
*.swo
*.swp
.DS_Store
.idea/
.zed/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Environment. Provider API keys live here; never commit one. A checked-in
# template is the one exception.
.env
.env.*
!.env.example

# Test & quality output: cargo-llvm-cov and cargo-mutants. The gates write
# under lablet/target/xtask; these are for runs by hand. `coverage/` is
# anchored to where such a run puts it, so that a source directory of that
# name (xtask/src/coverage/, a docs page) is never ignored without a word.
# For the same reason no source directory may be called `target`.
*.profdata
*.profraw
lcov.info
/coverage/
/lablet/coverage/
mutants.out*/

# Run output. The OTLP/JSON file exporter writes one file per run into the
# working directory by default, wherever `lablet run` was started. A fixture in
# this format that must be committed needs a different name.
lablet-*.otlp.jsonl

# Local configuration
*.local.toml

# Claude Code
.claude/settings.local.json
.claude/worktrees/
