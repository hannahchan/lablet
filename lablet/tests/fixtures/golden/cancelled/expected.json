        "gen_ai.conversation.id": "golden-cancelled",
        "gen_ai.operation.name": "invoke_agent",
        "gen_ai.tool.definitions": "[{\"description\":\"Runs a command with `bash -c` and returns what it wrote: standard output and standard error together, in the order they were written, then one line with the exit code, as `exit code: 0`. A command that exits with another code is a result like any other. Every command is a new process that starts in the run's root directory, so a working directory, a variable or a function that one command set isn't there for the next: write `cd dir && command` as one command. The call returns when the command has exited and nothing it started holds its output open, so send the output of a process that's to stay in the background somewhere else, as in `server > server.log 2>&1 &`. A command that runs for as long as a call may take is killed, with every process it started. A call that takes longer than 120s is stopped.\",\"name\":\"bash\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"command\":{\"description\":\"The command line, as it would be typed at a bash prompt.\",\"type\":\"string\"}},\"required\":[\"command\"],\"type\":\"object\"},\"type\":\"function\"},{\"description\":\"Returns the text of a file. A path that isn't absolute starts at the run's root directory, which is where `bash` starts, and a path that leads outside that directory once symbolic links are followed is refused. `offset` and `limit` choose lines, so a file too long to be returned whole can be read in parts: `offset` is how many lines to skip, and `limit` is how many to return after them. Bytes that aren't UTF-8 are returned as U+FFFD. A call that takes longer than 120s is stopped.\",\"name\":\"read_file\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"limit\":{\"description\":\"The most lines to return. Every line after the offset when left out.\",\"minimum\":1,\"type\":\"integer\"},\"offset\":{\"description\":\"How many lines to skip from the start of the file. None when left out.\",\"minimum\":0,\"type\":\"integer\"},\"path\":{\"description\":\"The file to read.\",\"type\":\"string\"}},\"required\":[\"path\"],\"type\":\"object\"},\"type\":\"function\"}]",
        "lablet.config.digest": "92068da5a766228d5a22712d6f08251ecc91d9d12ea6a1d428b2d7edc496a17f",
