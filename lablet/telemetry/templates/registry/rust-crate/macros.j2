{#- What a struct's fields and its `attributes()` look like, shared by the
    spans, the events and the `Join` struct. -#}
{%- macro header(crate_dir) -%}
// Generated by `cargo xtask weaver generate` from lablet/telemetry/registry/{{ crate_dir }}/; don't edit.
{%- endmacro -%}

{#- One field for each attribute: its own type when the registry requires it,
    an `Option` otherwise, and a map for a template. -#}
{%- macro fields(fields) -%}
{% for f in fields %}
    {{ f.brief | comment(indent=4) }}
    pub {{ f.ident }}: {% if f.optional and not f.template %}Option<{{ f.rust_type }}>{% else %}{{ f.rust_type }}{% endif %},
{% endfor %}
{%- endmacro -%}

{#- One `Attribute` for a field or a fixed value, with no branch: a field with
    no value is an attribute with none, which the hand-written functions leave
    out. -#}
{%- macro pair(f) -%}
{%- if f.optional and f.copy -%}
Attribute::new(key::{{ f.const }}, self.{{ f.ident }}.map(Value::from))
{%- elif f.optional -%}
Attribute::new(key::{{ f.const }}, self.{{ f.ident }}.clone().map(Value::from))
{%- elif f.copy -%}
Attribute::of(key::{{ f.const }}, self.{{ f.ident }})
{%- else -%}
Attribute::of(key::{{ f.const }}, self.{{ f.ident }}.clone())
{%- endif -%}
{%- endmacro -%}

{%- macro fixed(c) -%}
Attribute::of(key::{{ c.const }}, Self::{{ c.const }})
{%- endmacro -%}

{#- The body of `attributes()`: the join's attributes first when the signal
    carries them, then one line for each fixed value and field, and the
    templates last. One attribute to a line, so the function is as long as the
    signal has attributes and reads as the registry does; rustfmt would
    otherwise fold the longer lines and make its length a matter of key
    widths. -#}
{%- macro attributes(s) %}
    #[rustfmt::skip]
    #[must_use]
    pub fn attributes(&self) -> Vec<Attribute> {
{% if s.has_join %}
        let mut attributes = self.join.attributes();
        attributes.extend([
{% for c in s.consts %}
            {{ fixed(c) }},
{% endfor %}
{% for f in s.plain %}
            {{ pair(f) }},
{% endfor %}
        ]);
{% for f in s.templates %}
        attributes.extend(each_under(key::{{ f.const }}, &self.{{ f.ident }}));
{% endfor %}
        attributes
{% elif s.templates %}
        let mut attributes = vec![
{% for c in s.consts %}
            {{ fixed(c) }},
{% endfor %}
{% for f in s.plain %}
            {{ pair(f) }},
{% endfor %}
        ];
{% for f in s.templates %}
        attributes.extend(each_under(key::{{ f.const }}, &self.{{ f.ident }}));
{% endfor %}
        attributes
{% else %}
        vec![
{% for c in s.consts %}
            {{ fixed(c) }},
{% endfor %}
{% for f in s.plain %}
            {{ pair(f) }},
{% endfor %}
        ]
{% endif %}
    }
{%- endmacro -%}

{#- The constants of a signal's fixed values. -#}
{%- macro consts(s) -%}
{% for c in s.consts %}
    {{ [c.brief, "\n\nThe value of `" ~ c.key ~ "` on this signal."] | comment(indent=4) }}
    pub const {{ c.const }}: &str = "{{ c.value }}";
{% endfor %}
{%- endmacro -%}
